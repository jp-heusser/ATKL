---
/* Un evento: imagen, datos y tipos de entrada. */
import Panel from '../../../layouts/Panel.astro';
import EventFields from '../../../components/panel/EventFields.astro';
import ImageField from '../../../components/panel/ImageField.astro';
import { guard, pendingCount } from '../../../../server/panel.js';
import Event from '../../../../server/models/Event.js';
import TicketType from '../../../../server/models/TicketType.js';

const deny = guard(Astro, ['admin']);
if (deny) return deny;
const id = String(Astro.params.id);
const ev = /^[a-f0-9]{24}$/.test(id) ? await Event.findById(id).lean() : null;
if (!ev) return Astro.redirect('/panel/eventos');
const [types, pending] = await Promise.all([TicketType.find({ event: ev._id }).sort({ order: 1, price: 1 }).lean(), pendingCount()]);
---
<Panel title={ev.title} heading={ev.title} subtitle={`/evento/${ev.slug}`} active="eventos" pending={pending}>
  <a class="form-hint" href="/panel/eventos">← Todos los eventos</a>

  <section class="card">
    <ImageField kind="event" upload={`/api/admin/events/${id}/image`} current={ev.image} />
  </section>

  <form class="card form" data-api={`/api/admin/events/${id}`} data-method="PUT" data-ok="Evento guardado ✓">
    <span class="form-label">Datos del evento</span>
    <EventFields ev={ev} />
    <p class="msg" data-status hidden></p>
    <button type="submit" class="btn-primary">Guardar evento</button>
    {ev.status !== 'draft' && <a class="form-hint" href={`/evento/${ev.slug}`}>Ver página de venta →</a>}
  </form>

  <section class="card form">
    <span class="form-label">Tipos de entrada</span>
    {types.length === 0 && <p class="form-hint">Agrega al menos un tipo de entrada para vender por transferencia.</p>}
    {types.map((t) => (
      <form class:list={['tt-admin', 'form', { 'is-off': !t.active }]} data-api={`/api/admin/types/${t._id}`} data-method="PUT" data-then="reload">
        <div class="form-2">
          <label>Nombre<input name="name" maxlength="60" value={t.name} /></label>
          <label>Precio (CLP)<input name="price" inputmode="numeric" pattern="\d+" value={t.price} data-num /></label>
        </div>
        <div class="form-2">
          <label>Capacidad<input name="capacity" inputmode="numeric" pattern="\d+" value={t.capacity} data-num /></label>
          <label>Máx. por compra<input name="maxPerOrder" inputmode="numeric" pattern="\d+" value={t.maxPerOrder} data-num /></label>
        </div>
        <label>Descripción (opcional)<input name="description" maxlength="200" value={t.description} /></label>
        <p class="tt-stats">
          <span><strong>{t.sold}</strong> vendidas</span>
          <span><strong>{t.capacity - t.remaining - t.sold}</strong> en revisión</span>
          <span><strong>{t.remaining}</strong> disponibles</span>
        </p>
        <label class="check"><input type="checkbox" name="active" checked={t.active} /> A la venta</label>
        <p class="msg" data-status hidden></p>
        <button type="submit" class="btn-ghost">Guardar tipo</button>
      </form>
    ))}
    <form class="form tt-new" data-api={`/api/admin/events/${id}/types`} data-then="reload">
      <span class="form-label">Agregar tipo de entrada</span>
      <div class="form-2">
        <label>Nombre<input name="name" required maxlength="60" placeholder="Preventa" /></label>
        <label>Precio (CLP)<input name="price" required inputmode="numeric" pattern="\d+" placeholder="8000" data-num /></label>
      </div>
      <div class="form-2">
        <label>Capacidad<input name="capacity" required inputmode="numeric" pattern="\d+" placeholder="100" data-num /></label>
        <label>Máx. por compra<input name="maxPerOrder" required inputmode="numeric" pattern="\d+" value="6" data-num /></label>
      </div>
      <p class="msg" data-status hidden></p>
      <button type="submit" class="btn-ghost">+ Agregar</button>
    </form>
  </section>
</Panel>
