# Copia este archivo como ".env" y completa los valores. El .env NO se sube a git.

# Cadena de conexión de MongoDB Atlas (sin los < > del ejemplo de Atlas)
MONGODB_URI=mongodb+srv://USUARIO:CONTRASEÑA@cluster0.hd5lept.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=atkl

# Puerto de la API
PORT=3001

# Dominios que pueden usar la API, separados por coma (vacío = cualquiera)
CORS_ORIGIN=

# Clave para firmar las sesiones (larga y aleatoria). Generar una:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
